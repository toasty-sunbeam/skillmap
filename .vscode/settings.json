{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"cSpell.words": [
		"Iconify",
		"panzoom",
		"skillmap",
		"ymap"
	],
	"python-envs.pythonProjects": [
		{
			"path": "packages/sync-server-python",
			"envManager": "ms-python.python:venv",
			"packageManager": "ms-python.python:pip"
		}
	],
	"python-envs.defaultEnvManager": "ms-python.python:venv",
	"python.defaultInterpreterPath": "${workspaceFolder}/packages/sync-server-python/.venv/bin/python",
}
