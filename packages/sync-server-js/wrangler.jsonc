{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skillmap-sync-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-07",
	"durable_objects": {
		"bindings": [
			{
				"name": "SYNC_ROOM",
				"class_name": "SyncRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SyncRoom"]
		}
	]
}
